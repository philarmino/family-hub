# LAN-IP des HomePi (Port nur lokal binden)
HOMEPI_IP=192.168.178.98
PORT=8080
TZ=Europe/Berlin

# Standard-Personenanzahl für neue Wochenpläne
DEFAULT_SERVINGS=4

# Bring!-Account (Server-Push, Credentials bleiben auf dem Pi)
BRING_EMAIL=
BRING_PASSWORD=
BRING_LIST_UUID=

# Passwort, das Eltern beim „In Bring! legen“ eingeben müssen
BRING_PUSH_PASSWORD=family
